# Enforce LF line endings for all text files
* text=auto eol=lf

# Explicitly set for common file types
*.kt text eol=lf
*.java text eol=lf
*.ktm text eol=lf
*.kts text eol=lf
*.gradle text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.properties text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.jar binary
*.keystore binary
