{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git merge *)",
      "Bash(git reset *)",
      "Bash(git rebase *)",
      "Bash(git tag *)",
      "Bash(git clean *)",
      "Bash(git -C * commit *)",
      "Bash(git -C * push *)",
      "Bash(git -C * checkout *)",
      "Bash(git -C * switch *)",
      "Bash(git -C * merge *)",
      "Bash(git -C * reset *)",
      "Bash(git -C * rebase *)",
      "Bash(git -C * tag *)",
      "Bash(git -C * clean *)",
      "PowerShell(git commit *)",
      "PowerShell(git push *)",
      "PowerShell(git checkout *)",
      "PowerShell(git switch *)",
      "PowerShell(git merge *)",
      "PowerShell(git reset *)",
      "PowerShell(git rebase *)",
      "PowerShell(git tag *)",
      "PowerShell(git clean *)",
      "PowerShell(git -C * commit *)",
      "PowerShell(git -C * push *)",
      "PowerShell(git -C * checkout *)",
      "PowerShell(git -C * switch *)",
      "PowerShell(git -C * merge *)",
      "PowerShell(git -C * reset *)",
      "PowerShell(git -C * rebase *)",
      "PowerShell(git -C * tag *)",
      "PowerShell(git -C * clean *)",
      "Read(**/release-signing.local.properties)",
      "Read(**/release-signing.properties)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Bash(adb uninstall *)",
      "Bash(adb -s * uninstall *)",
      "Bash(adb shell pm clear *)",
      "Bash(adb -s * shell pm clear *)",
      "Bash(adb shell rm *)",
      "Bash(adb -s * shell rm *)",
      "PowerShell(adb uninstall *)",
      "PowerShell(adb -s * uninstall *)",
      "PowerShell(adb shell pm clear *)",
      "PowerShell(adb -s * shell pm clear *)",
      "PowerShell(adb shell rm *)",
      "PowerShell(adb -s * shell rm *)"
    ]
  }
}
