<?xml version="1.0" encoding="utf-8"?>
<!-- Enterprise-only components, merged into the main manifest for the enterprise flavor. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Camera & Mic Watch "Advanced mode": exact attribution from the system's
        app-ops record. Not grantable by the user or by Play - an administrator
        grants it with `adb shell pm grant <package> android.permission.GET_APP_OPS_STATS`.
        Enterprise build only; the consumer build never declares it.
    -->
    <uses-permission
        android:name="android.permission.GET_APP_OPS_STATS"
        tools:ignore="ProtectedPermissions" />

    <application>

        <!--
            Device / Profile Owner receiver for MDM / enterprise deployment.

            android:exported="true" is REQUIRED — the OS binds Device Admin
            receivers via the BIND_DEVICE_ADMIN permission. Without exported=true
            Device Admin activation silently fails.

            Only DEVICE_ADMIN_ENABLED goes here; APPLICATION_RESTRICTIONS_CHANGED
            is handled by MdmConfigReceiver, registered at runtime in FlavorStartup.
        -->
        <receiver
            android:name="com.privacyguard.mdm.DeviceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_receiver" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!--
            APPLICATION_RESTRICTIONS_CHANGED is only delivered to receivers
            registered at runtime, so MdmConfigReceiver is registered in
            FlavorStartup instead of being declared here.
        -->

        <!-- ── MDM / AppConfig metadata ───────────────────────────────────── -->

        <!--
            Declares the app's managed-configuration schema.
            EMM consoles (Intune, Workspace ONE, Jamf, etc.) read this to build
            their policy UI. Values are delivered at runtime via RestrictionsManager.
        -->
        <meta-data
            android:name="android.content.APP_RESTRICTIONS"
            android:resource="@xml/application_restrictions" />

    </application>

</manifest>
