<?xml version="1.0" encoding="utf-8"?>
<!-- Enterprise-only components, merged into the main manifest for the enterprise flavor. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>

        <!--
            Device / Profile Owner receiver for MDM / enterprise deployment.

            android:exported="true" is REQUIRED — the OS binds Device Admin
            receivers via the BIND_DEVICE_ADMIN permission. Without exported=true
            Device Admin activation silently fails.

            Only DEVICE_ADMIN_ENABLED goes here; APPLICATION_RESTRICTIONS_CHANGED
            is handled by the separate MdmConfigReceiver below (different permission
            requirement — the OS sends that broadcast without BIND_DEVICE_ADMIN).
        -->
        <receiver
            android:name="com.privacyguard.mdm.DeviceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_receiver" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!--
            Separate receiver for managed-configuration changes.
            The OS sends APPLICATION_RESTRICTIONS_CHANGED without the
            BIND_DEVICE_ADMIN permission, so this receiver must NOT carry
            that permission restriction.
        -->
        <receiver
            android:name="com.privacyguard.mdm.MdmConfigReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.APPLICATION_RESTRICTIONS_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- ── MDM / AppConfig metadata ───────────────────────────────────── -->

        <!--
            Declares the app's managed-configuration schema.
            EMM consoles (Intune, Workspace ONE, Jamf, etc.) read this to build
            their policy UI. Values are delivered at runtime via RestrictionsManager.
        -->
        <meta-data
            android:name="android.content.APP_RESTRICTIONS"
            android:resource="@xml/application_restrictions" />

    </application>

</manifest>
