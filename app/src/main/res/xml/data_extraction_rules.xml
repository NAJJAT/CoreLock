<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing leaves the device through backup or device-to-device transfer:
    the database holds DNS history and connection logs, and the shared
    preferences hold Keystore-wrapped secrets that are useless (or worse,
    confusing) on another device. See
    https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
