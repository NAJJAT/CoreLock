<?xml version="1.0" encoding="utf-8"?>
<!--
    Share only dedicated folders. The database, shared prefs, payload logs and the
    rest of files/ and cache/ must never be reachable through a content:// URI.
    The enterprise flavor replaces this file (src/enterprise/res/xml/file_paths.xml)
    to add its CA certificate folders; they never belong in the consumer app.
-->
<paths>
    <!-- PCAP captures, IT reports and CSV exports (files/exports/{pcap,reports,csv}) -->
    <files-path
        name="exports"
        path="exports/" />
</paths>
