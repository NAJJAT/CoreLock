<?xml version="1.0" encoding="utf-8"?>
<!--
    Managed Configuration (AppConfig) schema for PrivacyGuard enterprise deployment.

    EMM consoles (Intune, Workspace ONE, Jamf, etc.) read this file to build
    their policy configuration UI. Admins fill in values; the OS delivers them
    to the app via RestrictionsManager.getApplicationRestrictions().

    The app reads and applies these values via ManagedConfigApplier.apply().
-->
<restrictions xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ── Core MITM settings ──────────────────────────────────────────────── -->

    <restriction
        android:key="mitm_enabled"
        android:title="Enable HTTPS Payload Inspection"
        android:description="@string/restriction_mitm_enabled_desc"
        android:restrictionType="bool"
        android:defaultValue="false" />

    <restriction
        android:key="mitm_consent_given"
        android:title="Enterprise Legal Consent Pre-confirmed"
        android:description="@string/restriction_mitm_consent_desc"
        android:restrictionType="bool"
        android:defaultValue="false" />

    <restriction
        android:key="ca_install_automatic"
        android:title="Install CA Certificate Automatically"
        android:description="@string/restriction_ca_install_automatic_desc"
        android:restrictionType="bool"
        android:defaultValue="false" />

    <!-- ── PII and privacy ─────────────────────────────────────────────────── -->

    <restriction
        android:key="mitm_redact_pii"
        android:title="Redact PII from Payloads"
        android:description="@string/restriction_mitm_redact_pii_desc"
        android:restrictionType="bool"
        android:defaultValue="true" />

    <restriction
        android:key="mitm_retention_days"
        android:title="Payload Log Retention (days)"
        android:description="@string/restriction_mitm_retention_days_desc"
        android:restrictionType="integer"
        android:defaultValue="7" />

    <!-- ── SIEM / log shipping ─────────────────────────────────────────────── -->

    <restriction
        android:key="mitm_ship_to_siem"
        android:title="Ship Payloads to SIEM"
        android:description="@string/restriction_mitm_ship_to_siem_desc"
        android:restrictionType="bool"
        android:defaultValue="false" />

    <restriction
        android:key="mitm_siem_endpoint"
        android:title="SIEM Endpoint URL"
        android:description="@string/restriction_mitm_siem_endpoint_desc"
        android:restrictionType="string"
        android:defaultValue="" />

    <restriction
        android:key="mitm_siem_api_key"
        android:title="SIEM API Key"
        android:description="@string/restriction_mitm_siem_api_key_desc"
        android:restrictionType="string"
        android:defaultValue="" />

</restrictions>

