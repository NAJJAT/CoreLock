    <string name="restriction_mitm_enabled_desc" translatable="false">Turn on MITM traffic interception for all managed apps.</string>
    <string name="restriction_mitm_consent_desc" translatable="false">Set to true to confirm that the organisation has obtained the necessary legal consent to monitor employee HTTPS traffic on this device. When true the app skips the in-app consent dialog.</string>
    <string name="restriction_ca_install_automatic_desc" translatable="false">When true and the app is Device Owner or Profile Owner, the PrivacyGuard CA is installed into the system trust store silently without any user prompt. All apps on the device or work profile will then trust certificates signed by PrivacyGuard.</string>
    <string name="restriction_mitm_redact_pii_desc" translatable="false">Automatically redact personally identifiable information such as emails, phone numbers, credit cards, and passwords before storing or shipping payloads.</string>
    <string name="restriction_mitm_retention_days_desc" translatable="false">Number of days to keep intercepted payload logs on device. Allowed range: 1 to 90.</string>
    <string name="restriction_mitm_ship_to_siem_desc" translatable="false">Enable forwarding of intercepted payloads to the configured SIEM endpoint.</string>
    <string name="restriction_mitm_siem_endpoint_desc" translatable="false">HTTPS URL of the log aggregation or SIEM server, for example https://siem.corp.example.com/api/events.</string>
    <string name="restriction_mitm_siem_api_key_desc" translatable="false">Bearer token or API key used to authenticate requests to the SIEM endpoint.</string>
