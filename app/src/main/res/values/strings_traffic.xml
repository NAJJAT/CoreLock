    <string name="trf_pd_first">The app maker’s own servers: feed, messages, login. This can include the maker’s own usage logging, which runs on the same servers.</string>
    <string name="trf_pd_ads">Chooses, shows and measures ads, and builds an ad profile of you.</string>
    <string name="trf_pd_analytics">Records how you use the app and reports it to the developer or another company.</string>
    <string name="trf_pd_tracking">Another company’s SDK: crash reports, social login and sharing, fingerprinting or profiling.</string>
    <string name="trf_pd_cdn">Delivers images, video and app files from servers near you. Rarely used for tracking.</string>
    <string name="trf_pd_service">Another company’s service the app relies on, such as maps, payments or push messages.</string>
    <string name="trf_pd_unknown">Not in our lists. We don’t know who runs these; that alone doesn’t make them harmful.</string>

